rules_version = '2';

// Règles de sécurité de la base Firestore du site.
// À copier dans la console Firebase : Firestore Database > Règles > Publier.
//
// - Un compte créé est « en attente » (approved = false) tant qu'un chef ne l'a pas validé.
// - Chefs (role = 'chef') : accès à tout (comptes, résultats, statistiques, carnets, diplômes).
// - Scouts : uniquement leurs propres résultats, statistiques, carnet, diplômes et déclarations.
// - Chef d'équipage de la saison : les statistiques, le carnet, les demandes et le profil des membres
//   de son équipage, et la validation de leur carnet. Pas les autres équipages.
//   Les affectations sont recopiées sur les profils par les chefs : users/{uid}.eq = { '2026': '<id>' },
//   users/{uid}.ce = { '2026': '<id>' } (saison en chaîne).
// - Formateur (chef, ou titulaire confirmé du PE, du CQ ou du CF) : ses réponses aux questions sont
//   mises en avant. C'est tout : il ne voit pas les carnets des autres.
// - Diplômes : déclarés par le scout (diplomes/{uid}), confirmés par un chef (users/{uid}.dip).
// - Classement : agrégats par équipage (classement/{saison}_{eq}), lisibles par tous les inscrits,
//   écrits par un chef ou par le chef de cet équipage. Les notes individuelles ne sont pas exposées.
// - Questions-réponses : ouvertes à tous les inscrits validés.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().approved == true;
    }
    function chef() { return approved() && profile().role == 'chef'; }
    // saison scoute en cours : année de septembre, en chaîne ('2026')
    function saisonCourante() { return request.time.month() >= 9 ? request.time.year() : request.time.year() - 1; }
    function saisonS() { return string(saisonCourante()); }

    // diplômes confirmés : users/{uid}.dip = { pe: '2025-07', ... } ; un ancien pe == true compte comme PE
    function aDip(p, d) { return p.get('dip', {}).get(d, '') != ''; }
    function aPE(p) { return aDip(p, 'pe') || p.get('pe', false) == true; }
    function estFormateur(p) { return p.role == 'chef' || aPE(p) || aDip(p, 'cq') || aDip(p, 'cf'); }
    // titre affiché à côté du nom dans une réponse : un diplôme que l'auteur a vraiment
    function titreOk(p, t) { return (t == 'PE' && aPE(p)) || (t == 'CQ' && aDip(p, 'cq')) || (t == 'CF' && aDip(p, 'cf')); }

    // chef d'équipage du scout uid pour la saison s (chaîne) : même identifiant d'équipage
    // dans users/{moi}.ce[s] et users/{uid}.eq[s]
    function ceDe(uid, s) {
      return approved()
        && profile().get('ce', {}).get(s, '-')
           == get(/databases/$(database)/documents/users/$(uid)).data.get('eq', {}).get(s, '');
    }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function mois(m) { return m is string && m.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'); }
    function moisOk(d, k) { return !(k in d) || mois(d[k]); }
    // déclarations de diplômes : { code: 'AAAA-MM' }
    function declOk(d) {
      return d is map
        && d.keys().hasOnly(['pe_theo', 'pe_prat', 'pe', 'cq', 'cf', 'permis', 'psc1', 'cep1'])
        && moisOk(d, 'pe_theo') && moisOk(d, 'pe_prat') && moisOk(d, 'pe') && moisOk(d, 'cq')
        && moisOk(d, 'cf') && moisOk(d, 'permis') && moisOk(d, 'psc1') && moisOk(d, 'cep1');
    }

    match /users/{uid} {
      // soi-même, un chef, ou le chef d'équipage de la saison en cours (badges, nom)
      allow get: if signedIn() && (request.auth.uid == uid || chef()
        || (approved() && resource.data.get('eq', {}).get(saisonS(), '') == profile().get('ce', {}).get(saisonS(), '-')));
      allow list: if chef();
      // inscription : uniquement son propre profil, en attente, rôle élève
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'unite', 'email', 'role', 'approved', 'createdAt'])
        && str(request.resource.data.name, 80)
        && request.resource.data.unite is string && request.resource.data.unite.size() <= 80
        && request.resource.data.role == 'eleve'
        && request.resource.data.approved == false;
      // un chef modifie tout (validation, rôle, diplômes, équipage) ; chacun corrige son nom,
      // son unité et choisit son objectif
      allow update: if chef()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'unite', 'objectif'])
            && str(request.resource.data.name, 80)
            && request.resource.data.unite is string && request.resource.data.unite.size() <= 80
            && (!('objectif' in request.resource.data) || request.resource.data.objectif in ['PE', 'CQ', 'CF']));
      allow delete: if chef();
    }

    match /questions/{qid} {
      allow read: if approved();

      allow create: if approved()
        && request.resource.data.keys().hasOnly(['title', 'body', 'theme', 'authorId', 'authorName',
             'createdAt', 'lastAt', 'answers', 'chefAnswered', 'resolved'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == profile().name
        && str(request.resource.data.title, 200)
        && str(request.resource.data.body, 5000)
        && str(request.resource.data.theme, 40)
        && request.resource.data.answers == 0
        && request.resource.data.chefAnswered == false
        && request.resource.data.resolved == false;

      allow update: if chef()
        // l'auteur peut marquer sa question comme résolue
        || (approved() && resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']))
        // toute réponse incrémente le compteur et la date d'activité
        || (approved()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'lastAt', 'chefAnswered'])
            && request.resource.data.answers == resource.data.answers + 1
            && request.resource.data.chefAnswered == (resource.data.chefAnswered || estFormateur(profile())));

      allow delete: if chef()
        || (approved() && resource.data.authorId == request.auth.uid && resource.data.answers == 0);

      match /answers/{aid} {
        allow read: if approved();
        allow create: if approved()
          && request.resource.data.keys().hasOnly(['body', 'authorId', 'authorName', 'byChef', 'titre', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == profile().name
          && request.resource.data.byChef == estFormateur(profile())
          && (!('titre' in request.resource.data) || titreOk(profile(), request.resource.data.titre))
          && str(request.resource.data.body, 5000);
        allow update, delete: if chef();
      }
    }

    match /results/{rid} {
      // resource == null : un document absent (défi pas encore fait) se lit sans erreur
      allow read: if chef() || (approved() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'unite', 'mode', 'score', 'total', 'dur',
             'themes', 'ok', 'ko', 'at', 'semaine'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == profile().name
        && request.resource.data.mode in ['examen', 'entrainement', 'defi']
        // un seul essai au défi de la semaine : identifiant imposé, pas de modification possible
        && (request.resource.data.mode != 'defi'
            || (rid == 'defi_' + request.resource.data.semaine + '_' + request.auth.uid && request.resource.data.total == 10))
        && request.resource.data.score is int && request.resource.data.total is int
        && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total > 0 && request.resource.data.total <= 400
        && request.resource.data.themes is map
        && request.resource.data.ok is list && request.resource.data.ko is list
        && request.resource.data.ok.size() + request.resource.data.ko.size() <= 400
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if chef();
    }

    // ---------------------------------------------------- équipages et saisons
    match /equipages/{id} {
      allow read: if approved();
      allow write: if chef();
    }
    match /saisons/{saison}/equipages/{id} {
      allow read: if approved();
      allow write: if chef();
    }
    match /bonus/{id} {
      allow read: if approved();
      allow create: if chef() && request.resource.data.pts is int
        && request.resource.data.pts >= -20 && request.resource.data.pts <= 20;
      allow update: if false;
      allow delete: if chef();
    }

    // Résumé de saison d'un scout : lu par lui, les chefs, et le chef de son équipage cette saison-là
    // (document par document : seuls les chefs peuvent faire une requête sur la collection).
    match /stats/{sid} {
      allow get: if chef()
        || (approved() && (resource == null
            || resource.data.uid == request.auth.uid
            || ceDe(resource.data.uid, string(resource.data.saison))));
      allow list: if chef();
      allow create, update: if approved()
        && sid == string(request.resource.data.saison) + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'saison', 'mois', 'defis', 'epreuves'])
        && request.resource.data.mois is map && request.resource.data.defis is map
        && request.resource.data.epreuves is list && request.resource.data.epreuves.size() <= 200;
      allow delete: if chef();
    }

    // Classement publié : agrégats par équipage, sans note individuelle
    match /classement/{cid} {
      allow read: if approved();
      allow create, update: if approved()
        && request.resource.data.saison is int
        && request.resource.data.eq is string
        && cid == string(request.resource.data.saison) + '_' + request.resource.data.eq
        && request.resource.data.keys().hasOnly(['saison', 'eq', 'nom', 'membres', 'mois', 'total', 'sem', 'at'])
        && request.resource.data.mois is map
        && request.resource.data.at == request.time
        && (chef() || profile().get('ce', {}).get(string(request.resource.data.saison), '-') == request.resource.data.eq);
      allow delete: if chef();
    }

    // Carnet de progression (PE, CQ, CF) : validé par un chef ou par le chef d'équipage du scout,
    // jamais par le scout lui-même
    match /carnets/{uid} {
      allow get: if approved() && (request.auth.uid == uid || chef() || ceDe(uid, saisonS()));
      allow list: if chef();
      allow create, update: if (chef() || ceDe(uid, saisonS()))
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['v']);
      allow delete: if chef();
    }
    // Demandes de validation. Un chef d'équipage les lit par une requête sur l'uid de chaque équipier.
    match /demandes/{did} {
      // le chef d'équipage lit par une requête sur eq (son équipage de la saison)
      allow read: if approved()
        && (resource.data.uid == request.auth.uid || chef()
            || (resource.data.get('eq', '') != ''
                && resource.data.get('eq', '') == profile().get('ce', {}).get(saisonS(), '-')));
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && did == request.auth.uid + '_' + request.resource.data.item
        && request.resource.data.keys().hasOnly(['uid', 'name', 'eq', 'item', 'saison', 'at'])
        && request.resource.data.eq == profile().get('eq', {}).get(saisonS(), '')
        && request.resource.data.name == profile().name;
      allow update: if false;
      // resource == null : valider un point sans demande supprime une demande absente (même lot d'écritures)
      allow delete: if approved()
        && (resource == null || resource.data.uid == request.auth.uid || chef() || ceDe(resource.data.uid, saisonS()));
    }

    // Diplômes déclarés par le scout, en attente de confirmation : { d: { cq: '2026-04' }, at }.
    // La confirmation (par un chef) inscrit le diplôme dans users/{uid}.dip et retire la déclaration.
    match /diplomes/{uid} {
      allow get: if approved() && (request.auth.uid == uid || chef());
      allow list: if chef();
      allow create, update: if chef()
        || (approved() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['d', 'at'])
            && declOk(request.resource.data.d)
            && request.resource.data.at == request.time);
      allow delete: if approved() && (request.auth.uid == uid || chef());
    }
  }
}
